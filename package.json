{
  "name": "mission-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SRBC Mission Studio: parcels, equipment twin, coverage planner, and expert mission editor (JSON Agri v3).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"tests/js/**/*.{js,ts,tsx}\" \"frontend/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"tests/js/**/*.{js,ts,tsx}\" \"frontend/src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "lucide-react": "0.544.0",
    "maplibre-gl": "^6.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.16.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
