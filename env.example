PORT=3000
HOST=localhost
DEBUG=false
APP_LOGO_PATH=path/to/logo.png

# Chemin absolu ou relatif vers un répertoire contenant des plugins.
# Exemple: /opt/plugins ou ../my_company_plugins
PLUGINS_DIR=

# Configuration des tuiles Leaflet.
# Providers natifs: esri, osm, google. Pour un serveur XYZ, utiliser custom.
MAP_TILE_PROVIDER=esri
MAP_TILE_API_KEY=
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_TILE_MAX_ZOOM=22
MAP_TILE_MAX_NATIVE_ZOOM=19

# Options utilisées uniquement avec MAP_TILE_PROVIDER=google.
# mapType accepte notamment roadmap, satellite, terrain.
MAP_TILE_GOOGLE_MAP_TYPE=satellite
MAP_TILE_GOOGLE_LANGUAGE=fr-FR
MAP_TILE_GOOGLE_REGION=FR

# Configuration du champ de recherche de lieux.
# Providers supportés: nominatim, photon, google.
MAP_SEARCH_PROVIDER=nominatim
MAP_SEARCH_API_KEY=
MAP_SEARCH_URL=
MAP_SEARCH_LIMIT=5
# Laisser vide pour rechercher dans le monde entier. Exemple de restriction: fr,be,ch
MAP_SEARCH_COUNTRY_CODES=

# Chemin optionnel vers un schéma JSON Agri utilisé pour valider les fichiers
# avant sauvegarde. Laisser vide pour désactiver cette validation.
# Exemple: ../schema/Agri.json
AGRI_SCHEMA_PATH=

# Coquille Mission Studio (L1). false = /app reste l'éditeur actuel.
# true = /app sert la nouvelle coquille. /studio est toujours disponible.
# Raccourci local sans toucher ce fichier : http://localhost:3000/app?ui=v2
UI_SHELL_V2=false

# Transport FastAPI (L5). false = http.server (défaut, aucun SQLite).
# true = Uvicorn + FastAPI, fichier SQLite du catalogue / jobs.
BACKEND_FASTAPI=false
# SQLITE_PATH=backend/data/studio.sqlite
